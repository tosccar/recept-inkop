# Kopiera till .env och fyll i
# Auth (lämna tomma för att hoppa över inloggning lokalt)
AUTH_USERNAME=familjen
AUTH_PASSWORD=

# Anthropic API (för bildanalys och Coop-scraping)
ANTHROPIC_API_KEY=sk-ant-...
# Modell (valfritt; standard claude-sonnet-5-5). Byt här när en modell pensioneras.
RECEPT_CLAUDE_MODEL=claude-sonnet-5-5

# Google (valfritt, för Keep-integration)
GOOGLE_EMAIL=
GOOGLE_APP_PASSWORD=
